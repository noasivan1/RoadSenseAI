# gitignore for RoadSenseAI monorepo

# Raw uploaded artifacts
uploads/

# Generated pipeline output (annotated frames + dev state file)
output/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Environment files
.env
backend/.env
worker/.env

# Node
node_modules/
frontend/dist/

# Playwright / generic test-results (auto-regenerated on every run)
frontend/test-results/
**/test-results/

# Editor / agent local config — not for sharing
.vscode/
.claude/

# OS
.DS_Store
Thumbs.db

# Demo seed credentials (regenerated by scripts/seed_full_demo.py)
scripts/_demo_credentials.txt

# Defense-in-depth: personal prep / audit / book material that lives outside
# this repo. Listed here so that if any of these reappear at the project root
# by accident (copy-paste, file recovery, agent slip), they will not be staged.
/PLAN*.md
/BOOK-*.md
/UI-VALIDATION-*.md
/DB-STATE-AUDIT-REPORT.md
/MAINTENANCE_FACTS.md

# ── Added when publishing publicly: defense-in-depth for secrets / local files ──
# Any .env variant anywhere in the tree (e.g. frontend/.env.local, .env.production)
**/.env
**/.env.*
# ...but keep the documented templates
!**/.env.example
# Private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
# Logs and other editor/local state
*.log
logs/
.idea/
